# ─── Base de données (Neon PostgreSQL) ───────────────────────────────────────
# Pooled connection pour Prisma (production)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection pour les migrations
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# OBLIGATOIRES en production. En dev, valeurs par défaut utilisées si absents.
JWT_SECRET="changez_moi_secret_jwt_minimum_64_caracteres"
JWT_REFRESH_SECRET="changez_moi_secret_refresh_minimum_64_caracteres"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
OTP_TEST_ENABLED=false   # Mettre true uniquement en dev/test — jamais en production

# CORS_ORIGINS : liste séparée par des virgules. En production, JAMAIS `*`.
# Exemple : "https://app.tontinepro.com,https://admin.tontinepro.com"
CORS_ORIGINS=""

# ─── KKiaPay (Mobile Money Bénin) ────────────────────────────────────────────
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET_KEY=""
# Secret HMAC pour vérifier la signature des webhooks entrants
KKIAPAY_WEBHOOK_SECRET=""
KKIAPAY_SANDBOX=true

# ─── Mobile Money générique (fallback / autres opérateurs) ───────────────────
MOBILE_MONEY_SECRET=""

# ─── SMS provider (Twilio ou équivalent) ─────────────────────────────────────
SMS_PROVIDER_KEY=""
SMS_API_KEY=""
SMS_SENDER_ID="TontineBN"

# ─── WhatsApp Business ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─── Firebase (notifications push) ───────────────────────────────────────────
# Option A (Railway/prod) : JSON complet en une seule variable
# Obtenir avec : cat firebase-adminsdk-*.json | python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin)))"
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option B (dev local) : variables séparées — valeurs depuis Firebase Console > Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ─── Stockage fichiers KYC ───────────────────────────────────────────────────
CLOUDINARY_URL=""

# ─── Paramètres métier ───────────────────────────────────────────────────────
SEUIL_RETRAIT_ADMIN=50000
SEUIL_SCORE_PADME=70
SEUIL_SCORE_MICRO_CREDIT=60
DUREE_OTP_MINUTES=10
MAX_TENTATIVES_PIN=3
