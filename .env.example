# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/tontinepro_db"

# JWT
JWT_SECRET="votre_secret_jwt_très_long"
JWT_REFRESH_SECRET="votre_refresh_secret"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# KKiaPay
KKIAPAY_PUBLIC_KEY=""
KKIAPAY_PRIVATE_KEY=""
KKIAPAY_SECRET_KEY=""
KKIAPAY_SANDBOX=true

# SMS (Twilio)
SMS_API_KEY=""
SMS_SENDER_ID="TontinePro"

# WhatsApp Business
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Firebase
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Stockage fichiers
CLOUDINARY_URL=""

# App
PORT=3000
NODE_ENV=development
SEUIL_RETRAIT_ADMIN=50000
SEUIL_SCORE_PADME=70
SEUIL_SCORE_MICRO_CREDIT=60
DUREE_OTP_MINUTES=10
MAX_TENTATIVES_PIN=3
